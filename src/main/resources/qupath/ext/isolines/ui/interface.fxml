<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<fx:root type="VBox" spacing="10" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="420.0" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets topRightBottomLeft="10"/>
    </padding>

    <!-- Heatmap (density map) selection -->
    <HBox spacing="5" alignment="CENTER_LEFT">
        <Label text="%heatmap.label">
            <Tooltip text="%heatmap.tooltip"/>
        </Label>
        <TextField fx:id="heatmapPathField" editable="false" promptText="%heatmap.prompt" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnBrowseHeatmap" onAction="#browseHeatmap" text="%heatmap.browse.button">
            <Tooltip text="%heatmap.browse.tooltip"/>
        </Button>
    </HBox>

    <!-- Channel (only shown when the loaded density map has more than one) &amp; number of levels -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <HBox fx:id="channelBox" spacing="5" alignment="CENTER_LEFT">
            <Label text="%channel.label">
                <tooltip>
                    <Tooltip text="%channel.tooltip"/>
                </tooltip>
            </Label>
            <ComboBox fx:id="comboChannel" prefWidth="160.0"/>
        </HBox>
        <HBox spacing="5" alignment="CENTER_LEFT">
            <Label text="%levels.label">
                <tooltip>
                    <Tooltip text="%levels.tooltip"/>
                </tooltip>
            </Label>
            <Spinner fx:id="levelsSpinner" editable="true" prefWidth="75.0">
                <valueFactory>
                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="100" initialValue="8"/>
                </valueFactory>
            </Spinner>
        </HBox>
    </HBox>

    <!-- Clear existing isolines -->
    <CheckBox fx:id="cbClearExisting" text="%clear.checkbox">
        <tooltip>
            <Tooltip text="%clear.tooltip"/>
        </tooltip>
    </CheckBox>

    <!-- Mask outside a selected class -->
    <HBox spacing="5" alignment="CENTER_LEFT">
        <CheckBox fx:id="cbMaskByClass" text="%mask.checkbox">
            <tooltip>
                <Tooltip text="%mask.tooltip"/>
            </tooltip>
        </CheckBox>
        <ComboBox fx:id="comboMaskClass" disable="true" prefWidth="160.0" promptText="%mask.combo.prompt"/>
    </HBox>

    <!-- Simplify contour geometry -->
    <HBox spacing="5" alignment="CENTER_LEFT">
        <CheckBox fx:id="cbSimplify" text="%simplify.checkbox">
            <tooltip>
                <Tooltip text="%simplify.tooltip"/>
            </tooltip>
        </CheckBox>
        <Spinner fx:id="simplifyToleranceSpinner" editable="true" prefWidth="80.0" disable="true">
            <valueFactory>
                <SpinnerValueFactory.DoubleSpinnerValueFactory min="0.0" max="1000.0" initialValue="40.0" amountToStepBy="5.0"/>
            </valueFactory>
        </Spinner>
    </HBox>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnGenerateCode" onAction="#generateCode" text="%generatecode.button">
            <tooltip>
                <Tooltip text="%generatecode.tooltip"/>
            </tooltip>
        </Button>
        <Button fx:id="btnGenerateIsolines" onAction="#generateIsolines" text="%generate.button" defaultButton="true">
            <tooltip>
                <Tooltip text="%generate.tooltip"/>
            </tooltip>
        </Button>
    </HBox>

</fx:root>
